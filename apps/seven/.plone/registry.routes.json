[
  {
    "type": "layout",
    "file": "@plone/cmsui/routes/layout.tsx",
    "children": [
      {
        "type": "prefix",
        "path": "login",
        "children": [
          {
            "type": "route",
            "path": "*",
            "file": "@plone/cmsui/routes/auth/login.tsx"
          }
        ]
      },
      {
        "type": "prefix",
        "path": "logout",
        "children": [
          {
            "type": "route",
            "path": "*",
            "file": "@plone/cmsui/routes/auth/logout.tsx"
          }
        ]
      },
      {
        "type": "prefix",
        "path": "@@add",
        "children": [
          {
            "type": "route",
            "path": "*",
            "file": "@plone/cmsui/routes/add.tsx"
          }
        ]
      },
      {
        "type": "prefix",
        "path": "@@edit",
        "children": [
          {
            "type": "route",
